{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NekoCalendar",
  "version": "0.1.0",
  "identifier": "com.catdevstudio.nekocalendar",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NekoCalendar",
        "width": 1100,
        "height": 760,
        "minWidth": 800,
        "minHeight": 560,
        "center": true
      },
      {
        "label": "widget-countdown",
        "title": "NekoCalendar · Countdown",
        "url": "index.html",
        "width": 440,
        "height": 210,
        "x": 60,
        "y": 60,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": true,
        "skipTaskbar": true,
        "alwaysOnBottom": true,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "CatDevStudio",
    "copyright": "© 2026 CatDevStudio",
    "category": "Productivity",
    "shortDescription": "Calendario con widget desktop",
    "longDescription": "NekoCalendar: calendario con widget desktop personalizzabili, countdown e promemoria affidabili.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Italian", "English"]
      }
    }
  }
}
